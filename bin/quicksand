#!/usr/bin/env python3
"""
QuickSand - CLI tool for document malware detection and analysis.

This script provides a command-line interface to the QuickSand library,
allowing users to analyze documents for potential malware and exploits.
"""

from pathlib import Path
import sys

_local_src = Path(__file__).resolve().parent.parent / "src"
if (_local_src / "quicksand").is_dir():
    sys.path.insert(0, str(_local_src))

from quicksand import (
    BytesDump,
    keys_string,
    main,
    process_directory,
    process_file,
    quicksand,
    save_streams,
    txt_out,
)

__version__ = quicksand.__version__
__author__ = "Tyler McLellan"
__copyright__ = "Copyright 2026, @tylabs"
__license__ = "MIT"

if __name__ == "__main__":
    main()
